{
  "name": "stormfork-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "sh scripts/visual.sh",
    "test:update:visual": "sh scripts/visual.sh --update-snapshots"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
