from os import PathLike

from numpy.typing import ArrayLike

class Axes:
    def plot(
        self,
        x: ArrayLike,
        y: ArrayLike,
        *,
        color: str = ...,
        linewidth: float = ...,
        linestyle: str = ...,
        label: str = ...,
    ) -> object: ...
    def axvline(
        self, x: float, *, color: str = ..., linestyle: str = ..., label: str = ...
    ) -> object: ...
    def hist(
        self, x: ArrayLike, bins: str | int = ..., *, color: str = ..., edgecolor: str = ...
    ) -> object: ...
    def set_xlabel(self, xlabel: str) -> object: ...
    def set_ylabel(self, ylabel: str) -> object: ...
    def set_title(self, label: str) -> object: ...
    def legend(self, *, fontsize: str | float = ...) -> object: ...

class Figure:
    def __init__(self, *, figsize: tuple[float, float] = ..., layout: str = ...) -> None: ...
    def subplots(self) -> Axes: ...
    def savefig(self, fname: str | PathLike[str], *, dpi: float = ...) -> None: ...
